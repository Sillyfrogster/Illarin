# Copy this file to /etc/illarin/production.env and set its mode to 600.

ILLARIN_IMAGE_REGISTRY=ghcr.io/your-github-owner
ILLARIN_DATA_DIR=/srv/illarin
ILLARIN_SECRETS_DIR=/etc/illarin/secrets
ILLARIN_GATEWAY_BIND=127.0.0.1
ILLARIN_GATEWAY_PORT=8000

# Leave this empty when NPMPlus uses host networking. For bridge networking,
# set it to the name of NPMPlus's Docker network.
NPMPLUS_NETWORK=

SITE_URL=https://illarin.example

POSTGRES_DB=illarin
POSTGRES_USER=illarin
# Use a long URL-safe value because it also appears in DATABASE_URL.
POSTGRES_PASSWORD=replace-me
DATABASE_URL=postgres://illarin:replace-me@db:5432/illarin

# Umami page view counts, with the dashboard on the analytics subdomain.
# Use a URL-safe database password and an admin password of 8 or more characters.
UMAMI_DATABASE_PASSWORD=replace-me
UMAMI_ADMIN_PASSWORD=replace-me
UMAMI_APP_SECRET=replace-me

# Generate 32 random bytes and encode them as unpadded base64url. Each key does
# one job, so no two of these ever hold the same value.
LINKING_HMAC_KEY=replace-me
PUBLICATION_SECRET_KEY=replace-me

# Choose SMTP or Microsoft 365, never both. Leave all four SMTP values empty
# when using Microsoft 365. A relay without login needs only address and from.
SMTP_ADDR=
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=

# Leave these empty when using SMTP.
MICROSOFT_365_TENANT_ID=replace-me
MICROSOFT_365_CLIENT_ID=replace-me
MICROSOFT_365_MAILBOX=mailbox@illarin.example

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Off-box backups are disabled until a repository has been configured and a
# restore has been rehearsed. Normal startup does not need these values.
BACKUPS_ENABLED=false
RESTIC_REPOSITORY=
RESTIC_KEEP_DAILY=30
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=

# Keep enough room to pull images and replace containers. Application ingest
# keeps its own larger reserve below.
DEPLOY_MIN_FREE_MB=2048
STORAGE_FREE_SPACE_RESERVE_BYTES=5368709120
ACCOUNT_STORAGE_CAP_BYTES=1073741824
