{
  "note": "A link scheme that runs code",
  "path": "body.content.0.content.0.marks.0.href",
  "body": {
    "version": 2,
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Click",
            "marks": [{"type": "link", "href": "javascript:alert(1)"}]
          }
        ]
      }
    ]
  }
}
